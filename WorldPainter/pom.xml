<project>
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.pepsoft.worldpainter</groupId>
    <artifactId>WorldPainter</artifactId>
    <version>2.27.2-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>WorldPainter</name>
    <description>WorldPainter is an interactive map generator for Minecraft. It allows you to "paint" landscapes using similar tools as a regular paint program. Sculpt and mould the terrain, paint materials, trees, snow and ice, etc. onto it, and much more.</description>
    <url>https://www.worldpainter.net/</url>
    <inceptionYear>2011</inceptionYear>

    <licenses>
        <license>
            <name>GNU General Public License, version 3</name>
            <url>https://www.gnu.org/licenses/gpl-3.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <organization>
        <name>pepsoft.org</name>
        <url>https://www.pepsoft.org/</url>
    </organization>

    <developers>
        <developer>
            <name>Pepijn Schmitz</name>
            <organization>pepsoft.org</organization>
            <email>Pepijn.Schmitz@pepsoft.org</email>
            <timezone>Europe/Amsterdam</timezone>
        </developer>
    </developers>

    <modules>
        <module>WPCore</module>
        <module>WPDynmapPreviewer</module>
        <module>WPGUI</module>
    </modules>

    <repositories>
        <repository>
            <id>worldpainter-private</id>
            <url>https://www.worldpainter.net/maven-repo/</url>
            <releases>
                <enabled>true</enabled>
                <checksumPolicy>ignore</checksumPolicy>
            </releases>
        </repository>
    </repositories>

    <scm>
        <connection>scm:git:https://github.com/Captain-Chaos/WorldPainter.git</connection>
        <url>https://github.com/Captain-Chaos/WorldPainter</url>
    </scm>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-toolchains-plugin</artifactId>
                <version>1.1</version>
                <configuration>
                    <toolchains>
                        <jdk>
                            <version>17</version>
                        </jdk>
                    </toolchains>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>toolchain</goal>
                        </goals>
                    </execution>
                </executions>
                <inherited>true</inherited>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <source>17</source>
                        <target>17</target>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <argLine>-Duser.home=${project.build.directory}</argLine>
                    </configuration>
                </plugin>
                <!-- Inhibit regular deploy -->
                <plugin>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <configuration>
                        <skip>true</skip>
                    </configuration>
                    <inherited>true</inherited>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Core dependencies -->
        <pepsoft.utils.version>2.2.0</pepsoft.utils.version>
        <pepsoft.swingutils.version>2.0.0</pepsoft.swingutils.version>
        <pepsoft.jnbt.version>1.0.0</pepsoft.jnbt.version>
        <wp.valueobjects.version>1.2.0</wp.valueobjects.version>
        <jetbrains.annotations.version>24.0.1</jetbrains.annotations.version>
        <vecmath.version>1.3.1</vecmath.version>
        <imageio-tiff.version>3.8.2</imageio-tiff.version>
        <slf4j.version>1.7.36</slf4j.version>
        <nashorn-core.version>15.4</nashorn-core.version>
        <dynmap-core.version>3.6</dynmap-core.version>
        <snakeyaml.version>2.0</snakeyaml.version>
        <json-simple.version>1.1.1</json-simple.version>

        <!-- GUI dependencies -->
        <jpen.version>2-150301</jpen.version>
        <jide.version>3.8.1</jide.version>
        <laf-dark.version>201403101706</laf-dark.version>
        <logback.version>1.2.11</logback.version>
        <log4j-to-slf4j.version>2.17.2</log4j-to-slf4j.version>

        <!-- Test dependencies -->
        <junit.version>4.13.2</junit.version>

        <!-- Build dependencies -->
        <lombok.version>1.18.22</lombok.version>

        <!-- Maven plugin versions -->
        <maven-enforcer-plugin.version>3.3.0</maven-enforcer-plugin.version>
        <maven-failsafe-plugin.version>3.0.0-M6</maven-failsafe-plugin.version>
        <maven-javadoc-plugin.version>3.0.1</maven-javadoc-plugin.version>
        <maven-source-plugin.version>3.0.1</maven-source-plugin.version>
        <maven-gpg-plugin.version>1.6</maven-gpg-plugin.version>
        <buildnumber-maven-plugin.version>1.3</buildnumber-maven-plugin.version>
        <exec-maven-plugin.version>1.3.2</exec-maven-plugin.version>
        <maven-toolchains-plugin.version>1.1</maven-toolchains-plugin.version>
        <maven-jar-plugin.version>3.1.0</maven-jar-plugin.version>
    </properties>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <!-- Make sure we don't try to release snapshots -->
                    <plugin>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <version>${maven-enforcer-plugin.version}</version>
                        <executions>
                            <execution>
                                <phase>validate</phase>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireReleaseVersion/>
                                        <requireReleaseDeps/>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>${maven-failsafe-plugin.version}</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven-javadoc-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <author>false</author>
                                    <use>false</use>
                                    <version>false</version>
                                    <doclint>none</doclint>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven-source-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.8.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <ignorePublishedComponents>true</ignorePublishedComponents>
                            <waitUntil>uploaded</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>release-snapshot</id>
            <build>
                <plugins>
                    <!-- Make sure we only deploy snapshots -->
                    <plugin>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <version>${maven-enforcer-plugin.version}</version>
                        <executions>
                            <execution>
                                <phase>validate</phase>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireSnapshotVersion/>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.8.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <ignorePublishedComponents>true</ignorePublishedComponents>
                            <waitUntil>uploaded</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>integration-tests</id>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>${maven-failsafe-plugin.version}</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <argLine>-Djava.awt.headless=true</argLine>
                            <argLine>-Duser.home=${project.build.directory}</argLine>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>snapshot-dependencies</id>
            <repositories>
                <repository>
                    <id>oss-snapshots</id>
                    <url>https://oss.sonatype.org/content/repositories/snapshots</url>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </repository>
            </repositories>
        </profile>
        <!-- ================================================================= -->
        <!-- Welt (fork WorldPainter -> Java + Rust): profil natif -Pnative.    -->
        <!--                                                                     -->
        <!-- INERT PAR DEFAUT: ce profil ne modifie RIEN au build 100% Java     -->
        <!-- tant qu'il n'est pas active explicitement via -Pnative. Il est     -->
        <!-- declare dans le pom parent uniquement (aucune modification des     -->
        <!-- pom des modules).                                                  -->
        <!--                                                                     -->
        <!-- Usage:      mvn -Pnative -pl WPCore -am compile                    -->
        <!--             (construire la DLL Rust puis compiler WPCore qui       -->
        <!--              l'embarque; utilisez -am pour que le parent soit      -->
        <!--              bien dans le reacteur, sinon le profil ne s'execute  -->
        <!--              pas - il vit au validate du module parent)           -->
        <!--                                                                     -->
        <!-- Etape 1 - exec-maven-plugin, phase validate du module parent       -->
        <!--   (inherited=false: exactement UNE execution de cargo par build,   -->
        <!--   avant tout module). Lance cargo build en mode release sur le     -->
        <!--   manifest ../welt-native/Cargo.toml. Cargo must be on PATH;       -->
        <!--   RUSTUP_HOME/CARGO_HOME are inherited from the invoking process.  -->
        <!--   introuvable le build echoue immediatement avec l'erreur          -->
        <!--   "Cannot run program ... CreateProcess error=2" (message clair,   -->
        <!--   sans impact sur le build standard sans -Pnative).                -->
        <!--   Note: exec-maven-plugin 1.3.2 (version existante du projet,      -->
        <!--   deja utilisee par WPGUI) n'offre pas de parametre de timeout     -->
        <!--   pour le goal exec; le build attend donc simplement la fin de     -->
        <!--   cargo (le build Rust du workspace welt-native est rapide).       -->
        <!--                                                                     -->
        <!-- Etape 2 - maven-resources-plugin copy-resources, phase validate du  -->
        <!--   module parent (apres l'etape 1, meme phase, ordre de             -->
        <!--   declaration): copie                                             -->
        <!--     welt-native/target/release/welt_core.dll                       -->
        <!--   vers                                                               -->
        <!--     WPCore/src/main/resources/natives/windows-x86_64/welt_core.dll  -->
        <!--   Le dossier <os>-<arch> est derive des profils OS/architecture     -->
        <!--   ci-dessous. La configuration <resources>                         -->
        <!--   existante de WPCore embarque natives/ sans filtering (binaire     -->
        <!--   copie tel quel dans target/classes puis dans le jar WPCore).     -->
        <!--   Garde-fou: si cargo echoue, le build echoue a l'etape 1 (code     -->
        <!--   retour non nul remonte par exec:exec) AVANT la copie; si cargo    -->
        <!--   reussit, target/release existe forcement, donc une DLL perimee   -->
        <!--   ne peut pas etre embarquee silencieusement par ce profil.         -->
        <!--                                                                     -->
        <!-- ATTENTION: la DLL copiee dans src/main/resources persiste apres le  -->
        <!-- build; le build SANS -Pnative ne la touche jamais mais l'embarque   -->
        <!-- si elle est deja presente (comportement voulu: une fois le natif    -->
        <!-- construit, le build Java standard reste reproductible hors ligne).  -->
        <!-- Packaging final (install4j): le dossier natives/ doit etre          -->
        <!-- embarque dans le distributeur (a documenter dans la config          -->
        <!-- install4j, plan paragraphe 3, livrable 0.2).                         -->
        <!-- ================================================================= -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>${exec-maven-plugin.version}</version>
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <id>welt-cargo-build</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>cargo</executable>
                                    <arguments>
                                        <argument>build</argument>
                                        <argument>--release</argument>
                                        <argument>--manifest-path</argument>
                                        <argument>${project.basedir}/../welt-native/Cargo.toml</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <id>welt-copy-native-dll</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.basedir}/WPCore/src/main/resources/natives/${welt.native.os}-${welt.native.arch}</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}/../welt-native/target/release</directory>
                                            <includes>
                                                <include>${welt.native.binary}</include>
                                                <include>${welt.native.slices.binary}</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Platform properties are activated from the host JDK, so the same
             -Pnative build works from any clone and drive letter. -->
        <profile>
            <id>welt-platform-windows</id>
            <activation><os><family>Windows</family></os></activation>
            <properties><welt.native.os>windows</welt.native.os><welt.native.binary>welt_core.dll</welt.native.binary><welt.native.slices.binary>welt_slices.dll</welt.native.slices.binary></properties>
        </profile>
        <profile>
            <id>welt-platform-linux</id>
            <activation><os><name>Linux</name></os></activation>
            <properties><welt.native.os>linux</welt.native.os><welt.native.binary>libwelt_core.so</welt.native.binary><welt.native.slices.binary>libwelt_slices.so</welt.native.slices.binary></properties>
        </profile>
        <profile>
            <id>welt-platform-macos</id>
            <activation><os><family>Mac</family></os></activation>
            <properties><welt.native.os>macos</welt.native.os><welt.native.binary>libwelt_core.dylib</welt.native.binary><welt.native.slices.binary>libwelt_slices.dylib</welt.native.slices.binary></properties>
        </profile>
        <profile>
            <id>welt-arch-amd64</id>
            <activation><os><arch>amd64</arch></os></activation>
            <properties><welt.native.arch>x86_64</welt.native.arch></properties>
        </profile>
        <profile>
            <id>welt-arch-x86_64</id>
            <activation><os><arch>x86_64</arch></os></activation>
            <properties><welt.native.arch>x86_64</welt.native.arch></properties>
        </profile>
        <profile>
            <id>welt-arch-aarch64</id>
            <activation><os><arch>aarch64</arch></os></activation>
            <properties><welt.native.arch>aarch64</welt.native.arch></properties>
        </profile>
        <profile>
            <id>welt-arch-arm64</id>
            <activation><os><arch>arm64</arch></os></activation>
            <properties><welt.native.arch>aarch64</welt.native.arch></properties>
        </profile>
    </profiles>
</project>
